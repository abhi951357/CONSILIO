# Supabase Project Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase PostgreSQL Pooler (Universal IPv4 & IPv6)
DATABASE_HOST=aws-0-ap-south-1.pooler.supabase.com
DATABASE_PORT=6543
DATABASE_USER=postgres.your-project-ref
DATABASE_PASSWORD=your-database-password
DATABASE_NAME=postgres
DATABASE_URL=postgresql://postgres.your-project-ref:your-database-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Application Session Secret
SESSION_SECRET=your-secret-session-key

# Admin Dashboard Authentication (Server-side Only - Never expose to client)
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-secure-admin-password
